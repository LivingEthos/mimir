{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.dev/schemas/OverrideGrant.schema.json",
  "title": "OverrideGrant",
  "description": "Recorded grant of an above-default cap override. Written when an OverrideRequest is approved or auto-granted after N failed attempts. Paired with an override_granted audit event.",
  "type": "object",
  "required": [
    "schema_version",
    "grant_id",
    "request_id",
    "run_id",
    "granted_cap",
    "reason",
    "granted_by",
    "prior_failures",
    "auto_grant_after",
    "granted_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "grant_id": { "type": "string" },
    "request_id": { "type": "string" },
    "run_id": { "type": "string" },
    "granted_cap": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string" },
    "granted_by": {
      "type": "string",
      "enum": ["auto_after_failures", "user", "policy"]
    },
    "prior_failures": { "type": "integer", "minimum": 0 },
    "auto_grant_after": { "type": "integer", "minimum": 0 },
    "granted_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
