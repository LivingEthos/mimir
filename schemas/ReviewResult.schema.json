{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.dev/schemas/ReviewResult.schema.json",
  "title": "ReviewResult",
  "description": "Output of the fresh-context reviewer (Phase J of the workflow). Produced by single-reviewer and committee modes. The reviewer sees only the diff, changed source ranges, test cards, and high-risk omitted candidates — not the editor's prior reasoning.",
  "type": "object",
  "required": ["schema_version", "review_id", "packet_id", "verdict", "findings", "ran_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "review_id": { "type": "string" },
    "packet_id": { "type": "string", "description": "The reviewer packet's ID (not the editor's)." },
    "editor_run_id": { "type": "string", "description": "The run_id of the editor work being reviewed." },
    "verdict": { "type": "string", "enum": ["accept", "revise", "reject"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "category", "summary"],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "error_handling",
              "concurrency",
              "test_coverage",
              "test_impact",
              "docs_drift",
              "api_change",
              "performance",
              "pressure",
              "policy"
            ]
          },
          "summary": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "ranges"],
              "properties": {
                "path": { "type": "string" },
                "ranges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["start", "end"],
                    "properties": {
                      "start": { "type": "integer", "minimum": 1 },
                      "end": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            }
          },
          "specialists": {
            "type": "array",
            "description": "If committee mode, which specialists raised this finding.",
            "items": {
              "type": "string",
              "enum": ["correctness_security", "error_handling_concurrency", "test_impact_coverage", "docs_api_impact", "pressure"]
            }
          },
          "blocking": { "type": "boolean", "description": "If true, this finding blocks acceptance regardless of verdict." }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "coverage_concerns": {
      "type": "array",
      "description": "Areas where the reviewer cannot reach a conclusion due to missing evidence.",
      "items": {
        "type": "object",
        "required": ["concern", "what_would_resolve"],
        "properties": {
          "concern": { "type": "string" },
          "what_would_resolve": { "type": "string" }
        }
      }
    },
    "committee_mode": { "type": "boolean", "default": false },
    "ran_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
