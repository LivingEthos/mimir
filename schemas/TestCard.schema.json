{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.dev/schemas/TestCard.schema.json",
  "title": "TestCard",
  "description": "Structured replacement for raw test logs. Generated by parsing the test runner output.",
  "type": "object",
  "required": [
    "schema_version",
    "card_id",
    "command",
    "framework",
    "passed",
    "failed",
    "skipped",
    "duration_ms",
    "log_artifact_path"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "card_id": { "type": "string" },
    "command": { "type": "string" },
    "framework": { "type": "string", "enum": ["pytest", "vitest", "jest", "mocha", "cargo_test", "go_test", "unknown"] },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "top_failure": {
      "type": ["object", "null"],
      "properties": {
        "test_name": { "type": "string" },
        "message": { "type": "string" },
        "file_path": { "type": ["string", "null"] },
        "line_number": { "type": ["integer", "null"] }
      }
    },
    "stack_top": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Top frames of the first failure's stack trace."
    },
    "suspected_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "log_artifact_path": { "type": "string" }
  },
  "additionalProperties": false
}
