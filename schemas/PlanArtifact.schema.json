{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.dev/schemas/PlanArtifact.schema.json",
  "title": "PlanArtifact",
  "description": "The persisted implementation-plan artifact written by `mimir plan`. This is intentionally separate from PatchPlan, which is code-mode patch metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "packet_id",
    "packet_hash",
    "provider",
    "model",
    "task",
    "editable_target_set",
    "steps",
    "risks",
    "files_likely_affected",
    "tests_to_run",
    "assumptions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$"
    },
    "packet_id": { "type": "string" },
    "packet_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "task": { "type": "string" },
    "editable_target_set": {
      "type": "array",
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_likely_affected": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tests_to_run": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_response": {
      "type": "string",
      "description": "Redacted provider prose preserved only when structured JSON parsing failed."
    }
  },
  "additionalProperties": false
}
