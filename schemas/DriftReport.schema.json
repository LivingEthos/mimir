{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.dev/schemas/DriftReport.schema.json",
  "title": "DriftReport",
  "description": "Output of `ProviderAdapter::calibrate`. Records per-payload local-vs-server token-count drift and produces P50/P95/P99 summary statistics that update `ProviderCapabilities.count_drift_*_observed`.",
  "type": "object",
  "required": ["schema_version", "provider", "model", "samples", "drift_p50", "drift_p95", "drift_p99", "ran_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["local_tokens", "server_tokens", "drift_ratio"],
        "properties": {
          "local_tokens": { "type": "integer", "minimum": 0 },
          "server_tokens": { "type": "integer", "minimum": 1 },
          "drift_ratio": { "type": "number" },
          "payload_class": { "type": "string", "enum": ["tiny", "standard", "complex"] }
        }
      }
    },
    "drift_p50": { "type": "number", "minimum": 0 },
    "drift_p95": { "type": "number", "minimum": 0 },
    "drift_p99": { "type": "number", "minimum": 0 },
    "recommended_reserve_tokens": {
      "type": "integer",
      "minimum": 0,
      "description": "Recommended `count_drift_reserve_tokens` derived from drift_p95 and cap."
    },
    "ran_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
