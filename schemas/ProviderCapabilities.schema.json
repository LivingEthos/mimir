{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.dev/schemas/ProviderCapabilities.schema.json",
  "title": "ProviderCapabilities",
  "description": "Per-provider, per-model capability snapshot. Loaded at startup; validated by `mimir providers doctor`. The gateway refuses calls if the packet's capability_snapshot does not match the current registry entry.",
  "type": "object",
  "required": ["schema_version", "provider", "models"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string" },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "max_context_tokens",
          "max_input_tokens",
          "max_output_tokens",
          "output_reserve_tokens",
          "counts_system_tokens",
          "counts_tool_schemas",
          "counts_tool_results",
          "counts_reasoning_tokens",
          "supports_server_token_count",
          "supports_prompt_cache",
          "overflow_behavior",
          "pricing"
        ],
        "properties": {
          "max_context_tokens": { "type": "integer", "minimum": 1 },
          "max_input_tokens": { "type": "integer", "minimum": 1 },
          "max_output_tokens": { "type": "integer", "minimum": 1 },
          "output_reserve_tokens": { "type": "integer", "minimum": 0 },
          "counts_system_tokens": { "type": "boolean" },
          "counts_tool_schemas": { "type": "boolean" },
          "counts_tool_results": { "type": "boolean" },
          "counts_reasoning_tokens": { "type": "boolean" },
          "supports_server_token_count": { "type": "boolean" },
          "supports_prompt_cache": { "type": "boolean" },
          "overflow_behavior": {
            "type": "string",
            "enum": ["validation_error", "stop_reason", "truncation", "unknown"]
          },
          "pricing": {
            "type": "object",
            "required": ["input_per_million", "output_per_million"],
            "properties": {
              "input_per_million": { "type": "number", "minimum": 0 },
              "output_per_million": { "type": "number", "minimum": 0 },
              "cache_write_per_million": { "type": "number", "minimum": 0 },
              "cache_read_per_million": { "type": "number", "minimum": 0 }
            }
          },
          "count_drift_p50_observed": { "type": ["number", "null"], "minimum": 0 },
          "count_drift_p95_observed": { "type": ["number", "null"], "minimum": 0 },
          "count_drift_p99_observed": { "type": ["number", "null"], "minimum": 0 },
          "drift_calibrated_at": { "type": ["string", "null"], "format": "date-time" },
          "recommended_cap_tokens": {
            "type": ["integer", "null"],
            "description": "If non-null, the eval-suite-derived recommended cap for this model."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
