{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.dev/schemas/EvalCase.schema.json",
  "title": "EvalCase",
  "description": "A single eval fixture: prompt + repo + gold ranges + expected tests.",
  "type": "object",
  "required": ["schema_version", "id", "repo_path", "base_commit", "task", "gold", "allowed_mode"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string" },
    "repo_path": { "type": "string" },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "task": { "type": "string" },
    "gold": {
      "type": "object",
      "required": ["files", "ranges"],
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "start", "end"],
            "properties": {
              "path": { "type": "string" },
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "distractors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expected_tests": { "type": "array", "items": { "type": "string" } },
    "allowed_mode": { "type": "string", "enum": ["ask", "plan", "code", "review", "explain"] },
    "allowed_caps_to_test": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "generated": { "type": "boolean", "default": false, "description": "True if auto-generated by the auto-fixture pipeline." }
  },
  "additionalProperties": false
}
