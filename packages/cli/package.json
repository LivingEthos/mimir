{
  "name": "@mimir/cli",
  "version": "1.0.0",
  "private": true,
  "description": "Mimir CLI — context-governed AI coding inside ideal context limits",
  "bin": {
    "mimir": "bin/mimir"
  },
  "files": [
    "README.md",
    "bin/mimir",
    "install.js",
    "package.json"
  ],
  "scripts": {
    "prepack": "node --check ./bin/mimir && node --check ./install.js && node ../../scripts/verify-platform-package.mjs --all --require-platform-binaries",
    "postinstall": "node ./install.js"
  },
  "optionalDependencies": {
    "@mimir/cli-darwin-arm64": "1.0.0",
    "@mimir/cli-darwin-x64": "1.0.0",
    "@mimir/cli-linux-arm64": "1.0.0",
    "@mimir/cli-linux-x64": "1.0.0",
    "@mimir/cli-win32-x64": "1.0.0"
  },
  "keywords": [
    "cli",
    "ai",
    "coding-agent",
    "context-engineering",
    "context-window",
    "llm"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LivingEthos/mimir.git"
  }
}
