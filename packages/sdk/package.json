{
  "name": "@mimir/sdk",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript schema types for Mimir context-governed coding workflows",
  "types": "index.d.ts",
  "files": [
    "*.ts",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "check:schema-drift": "node scripts/check-drift.mjs",
    "prepack": "npm run generate && npm run check:schema-drift && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('index.d.ts',{force:true})\""
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.0.0"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LivingEthos/mimir.git"
  }
}
